<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Quản lý yêu cầu bài hát</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #f5f5f5;
    color: #222;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

header {
    background: #111;
    color: white;
    text-align: center;
    padding: 20px 15px;
}

header h1 {
    margin: 0;
    font-size: 23px;
}

.tabs {
    display: flex;
    background: white;
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid #ddd;
}

.tab {
    flex: 1;
    padding: 15px 10px;
    border: none;
    background: white;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
}

.tab.active {
    color: #007aff;
    border-bottom: 3px solid #007aff;
}

#requests {
    max-width: 700px;
    margin: auto;
    padding: 15px;
}

.card {
    background: white;
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.song {
    font-size: 21px;
    font-weight: 700;
    margin-bottom: 14px;
}

.info {
    margin: 7px 0;
    font-size: 15px;
}

.label {
    font-weight: 600;
}

.message {
    margin-top: 10px;
    padding: 10px;
    border-radius: 8px;
    background: #f5f5f5;
}

.time {
    margin-top: 12px;
    color: #888;
    font-size: 13px;
}

.buttons {
    display: flex;
    gap: 10px;
    margin-top: 17px;
}

.action {
    flex: 1;
    padding: 12px 8px;
    border: none;
    border-radius: 9px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
}

.complete {
    background: #34c759;
    color: white;
}

.delete {
    background: #ff3b30;
    color: white;
}

.empty {
    text-align: center;
    color: #888;
    padding: 50px 20px;
}
</style>
</head>

<body>

<header>
    <h1>🎵 Yêu cầu bài hát</h1>
</header>

<div class="tabs">

    <button id="pendingTab" class="tab active">
        Đang chờ
    </button>

    <button id="completedTab" class="tab">
        Đã hoàn thành
    </button>

</div>

<div id="requests"></div>

<script>

/* ==========================================
   SUPABASE
========================================== */

const SUPABASE_URL = "https://ehvaahtsqxoscusanksj.supabase.co";

const SUPABASE_ANON_KEY = "sb_publishable_WmtNVF8-FRnB60urP86nBA_O7qnbKyt";

const supabaseClient = supabase.createClient(
    SUPABASE_URL,
    SUPABASE_ANON_KEY
);


/* ==========================================
   TAB HIỆN TẠI

   pending   = Đang chờ
   completed = Đã hoàn thành
========================================== */

let currentTab = "pending";


/* ==========================================
   TẢI DỮ LIỆU
========================================== */

async function loadRequests() {

    let query = supabaseClient
        .from("requests")
        .select("*")
        .order("created_at", {
            ascending: false
        });


    if (currentTab === "pending") {

        query = query.eq("status", "pending");

    }

    if (currentTab === "completed") {

        query = query.eq("status", "completed");

    }


    const { data, error } = await query;


    if (error) {

        console.error("Lỗi tải dữ liệu:", error);

        document.getElementById("requests").innerHTML = `
            <div class="empty">
                Không thể tải yêu cầu.
            </div>
        `;

        return;
    }


    renderRequests(data);
}


/* ==========================================
   HIỂN THỊ DANH SÁCH
========================================== */

function renderRequests(data) {

    const container = document.getElementById("requests");

    container.innerHTML = "";


    if (!data || data.length === 0) {

        if (currentTab === "pending") {

            container.innerHTML = `
                <div class="empty">
                    Không có yêu cầu đang chờ.
                </div>
            `;

        }


        if (currentTab === "completed") {

            container.innerHTML = `
                <div class="empty">
                    Chưa có bài nào hoàn thành.
                </div>
            `;

        }

        return;
    }


    data.forEach(request => {

        const card = document.createElement("div");

        card.className = "card";


        const date = new Date(request.created_at);


        const time = date.toLocaleString("vi-VN", {
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit"
        });


        card.innerHTML = `

            <div class="song">
                🎵 ${escapeHTML(request.song_request || "")}
            </div>

            <div class="info">
                <span class="label">
                    Tên khách:
                </span>

                ${escapeHTML(request.customer_name || "")}
            </div>


            <div class="info">
                <span class="label">
                    Muốn gửi cho:
                </span>

                ${escapeHTML(request.send_to || "")}
            </div>


            ${
                request.message
                ? `
                    <div class="message">
                        💬 ${escapeHTML(request.message)}
                    </div>
                `
                : ""
            }


            <div class="time">
                🕐 ${time}
            </div>


            <div class="buttons">

                ${
                    currentTab === "pending"
                    ? `
                        <button
                            class="action complete"
                            onclick="markCompleted('${request.id}')">

                            ✓ Đang chờ

                        </button>
                    `
                    : ""
                }


                <button
                    class="action delete"
                    onclick="deleteRequest('${request.id}')">

                    🗑 Xóa yêu cầu

                </button>

            </div>
        `;


        container.appendChild(card);

    });
}


/* ==========================================
   CHUYỂN PENDING → COMPLETED
========================================== */

async function markCompleted(id) {

    const { error } = await supabaseClient

        .from("requests")

        .update({
            status: "completed"
        })

        .eq("id", id);


    if (error) {

        console.error("Lỗi cập nhật:", error);

        alert(
            "Không thể chuyển sang Đã hoàn thành."
        );

        return;
    }


    await loadRequests();
}


/* ==========================================
   XÓA YÊU CẦU
========================================== */

async function deleteRequest(id) {

    const confirmDelete = confirm(
        "Bạn có chắc muốn xóa yêu cầu này không?"
    );


    if (!confirmDelete) {

        return;
    }


    const { error } = await supabaseClient

        .from("requests")

        .delete()

        .eq("id", id);


    if (error) {

        console.error("Lỗi xóa:", error);

        alert(
            "Không thể xóa yêu cầu."
        );

        return;
    }


    await loadRequests();
}


/* ==========================================
   TAB PENDING
========================================== */

document
    .getElementById("pendingTab")
    .addEventListener("click", function() {

        currentTab = "pending";


        document
            .getElementById("pendingTab")
            .classList
            .add("active");


        document
            .getElementById("completedTab")
            .classList
            .remove("active");


        loadRequests();

    });


/* ==========================================
   TAB COMPLETED
========================================== */

document
    .getElementById("completedTab")
    .addEventListener("click", function() {

        currentTab = "completed";


        document
            .getElementById("completedTab")
            .classList
            .add("active");


        document
            .getElementById("pendingTab")
            .classList
            .remove("active");


        loadRequests();

    });


/* ==========================================
   REALTIME
========================================== */

supabaseClient

    .channel("requests-realtime")

    .on(
        "postgres_changes",

        {
            event: "*",
            schema: "public",
            table: "requests"
        },

        function(payload) {

            console.log(
                "Có thay đổi:",
                payload
            );

            loadRequests();

        }
    )

    .subscribe();


/* ==========================================
   CHỐNG HTML INJECTION
========================================== */

function escapeHTML(text) {

    return String(text)

        .replace(/&/g, "&amp;")

        .replace(/</g, "&lt;")

        .replace(/>/g, "&gt;")

        .replace(/"/g, "&quot;")

        .replace(/'/g, "&#039;");
}


/* ==========================================
   KHỞI ĐỘNG
========================================== */

loadRequests();

</script>

</body>
</html>

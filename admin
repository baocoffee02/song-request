  /* =====================================================
     ĐỊNH DẠNG THỜI GIAN
     ===================================================== */

  function formatDate(dateString) {

    if (!dateString) {

      return "";

    }


    const date =
      new Date(
        dateString
      );


    return date.toLocaleString(
      "vi-VN",
      {

        day:
          "2-digit",

        month:
          "2-digit",

        year:
          "numeric",

        hour:
          "2-digit",

        minute:
          "2-digit"

      }
    );

  }


  /* =====================================================
     CHỐNG HTML
     ===================================================== */

  function escapeHtml(value) {

    return String(value)

      .replace(
        /&/g,
        "&amp;"
      )

      .replace(
        /</g,
        "&lt;"
      )

      .replace(
        />/g,
        "&gt;"
      )

      .replace(
        /"/g,
        "&quot;"
      )

      .replace(
        /'/g,
        "&#039;"
      );

  }


  /* =====================================================
     CHỐNG LỖI KHI ĐƯA LINK VÀO ONCLICK
     ===================================================== */

  function escapeJs(value) {

    return String(value)

      .replace(
        /\\/g,
        "\\\\"
      )

      .replace(
        /'/g,
        "\\'"
      )

      .replace(
        /"/g,
        '\\"'
      )

      .replace(
        /\r?\n/g,
        "\\n"
      );

  }



<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>QUẢN LÝ YÊU CẦU</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;

      /* ===== HÌNH NỀN ===== */
      background-image:
        linear-gradient(rgba(0,0,0,0.35), rgba(0,0,0,0.35)),
        url("./80E39ED9-E68A-40A0-802C-840E92BDC4B1.jpeg");

      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      min-height: 100vh;
    }

    .container {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      padding: 20px;
    }

    h1 {
      text-align: center;
      color: white;
      margin: 10px 0 20px;
      text-shadow: 0 2px 5px rgba(0,0,0,0.5);
    }

    .tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 15px;
    }

    .tab {
      flex: 1;
      padding: 13px;
      border: none;
      border-radius: 10px;
      background: rgba(255,255,255,0.85);
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .tab.active {
      background: #222;
      color: white;
    }

    .clear-completed {
      width: 100%;
      padding: 12px;
      margin-bottom: 15px;
      border: none;
      border-radius: 10px;
      background: #d63031;
      color: white;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }

    .request {
      background: rgba(255,255,255,0.95);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 14px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.18);
    }

    .request-title {
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .info {
      margin: 6px 0;
      line-height: 1.4;
    }

    .label {
      font-weight: bold;
    }

    .message {
      margin-top: 10px;
      padding: 10px;
      background: #f2f2f2;
      border-radius: 8px;
    }

    .time {
      color: #666;
      font-size: 13px;
      margin-top: 10px;
    }

    .status {
      color: #666;
      font-size: 13px;
      margin-top: 10px;
      white-space: nowrap;
    }

    .priority-icon {
      font-size: 22px;
      line-height: 1;
      margin-top: 10px;
    }

    .time-status {
      display: flex;
      align-items: center;
    }

    .time {
      flex: 1;
    }

    .priority-icon {
      width: 40px;
      text-align: center;
    }

    .status {
      flex: 1;
      text-align: right;
    }

    .buttons {
      display: flex;
      gap: 8px;
      margin-top: 14px;
    }

    .buttons button {
      flex: 1;
      border: none;
      border-radius: 9px;
      padding: 11px 8px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
    }

    .complete-btn {
      background: #27ae60;
      color: white;
    }

    /* ===== NÚT YOUTUBE ===== */

    .youtube-btn {
      background: #222;
      color: white;
    }

    .youtube-btn.has-youtube {
      background: #27ae60;
      color: white;
    }

    .youtube-btn:active {
      opacity: 0.8;
    }

    .delete-btn {
      background: #e74c3c;
      color: white;
    }

    .empty {
      background: rgba(255,255,255,0.9);
      padding: 30px;
      border-radius: 14px;
      text-align: center;
      color: #555;
    }

    .error {
      background: #ffe5e5;
      color: #c0392b;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 15px;
      font-weight: bold;
    }

    .loading {
      background: rgba(255,255,255,0.9);
      padding: 20px;
      border-radius: 12px;
      text-align: center;
    }

    .tab span {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-width: 24px;
      height: 24px;

      margin-left: 5px;
      padding: 0 6px;

      border-radius: 50px;

      background: #e74c3c;
      color: white;

      font-size: 13px;
      font-weight: bold;
    }

    /* =====================================================
       POPUP YOUTUBE
       ===================================================== */

    #youtubeModal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.75);
      z-index: 99999;

      align-items: center;
      justify-content: center;

      padding: 20px;
    }

    .youtube-popup {
      position: relative;
      width: 100%;
      max-width: 800px;
      background: #000;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 5px 30px rgba(0,0,0,0.5);
    }

    .youtube-video {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
    }

    .youtube-video iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }

    .youtube-close {
      position: absolute;
      right: 8px;
      top: 8px;

      width: 38px;
      height: 38px;

      border: none;
      border-radius: 50%;

      background: rgba(0,0,0,0.75);
      color: white;

      font-size: 22px;
      font-weight: bold;

      cursor: pointer;
      z-index: 2;
    }

    .youtube-close:hover {
      background: rgba(0,0,0,0.95);
    }

  </style>
</head>

<body>

<div class="container">

  <h1>QUẢN LÝ YÊU CẦU</h1>

  <div class="tabs">

    <button
      id="pendingTab"
      class="tab active"
      onclick="showTab('pending')">
      Đang chờ <span id="pendingCount">0</span>
    </button>

    <button
      id="completedTab"
      class="tab"
      onclick="showTab('completed')">
      Đã hoàn thành <span id="completedCount">0</span>
    </button>

  </div>

  <button
    id="clearCompletedButton"
    class="clear-completed"
    onclick="deleteAllCompleted()"
    style="display:none;">
    🗑 Xóa tất cả bài đã hoàn thành
  </button>

  <div id="errorBox"></div>

  <div id="requests">

    <div class="loading">
      Đang tải dữ liệu...
    </div>

  </div>

</div>


<!-- =====================================================
     POPUP YOUTUBE
     ===================================================== -->

<div id="youtubeModal">

  <div class="youtube-popup">

    <button
      class="youtube-close"
      onclick="closeYoutube()">
      ✕
    </button>

    <div class="youtube-video">

      <iframe
        id="youtubeFrame"
        src=""
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen>
      </iframe>

    </div>

  </div>

</div>


<script>

  /* =====================================================
     SUPABASE
     ===================================================== */

  const SUPABASE_URL =
    "https://ehvaahtsqxoscusanksj.supabase.co";

  const SUPABASE_ANON_KEY =
    "sb_publishable_WmtNVF8-FRnB60urP86nBA_O7qnbKyt";

  const supabaseClient =
    supabase.createClient(
      SUPABASE_URL,
      SUPABASE_ANON_KEY
    );


  /* =====================================================
     BIẾN
     ===================================================== */

  let currentTab = "pending";

  let lastDataSignature = "";


  /* =====================================================
     HIỂN THỊ TAB
     ===================================================== */

  function showTab(tab) {

    currentTab = tab;

    document
      .getElementById("pendingTab")
      .classList.toggle(
        "active",
        tab === "pending"
      );

    document
      .getElementById("completedTab")
      .classList.toggle(
        "active",
        tab === "completed"
      );

    updateClearCompletedButton();

    loadRequests(true);
  }


  /* =====================================================
     NÚT XÓA TẤT CẢ BÀI ĐÃ HOÀN THÀNH
     ===================================================== */

  function updateClearCompletedButton() {

    const button =
      document.getElementById(
        "clearCompletedButton"
      );

    if (currentTab === "completed") {

      button.style.display = "block";

    } else {

      button.style.display = "none";

    }

  }


  /* =====================================================
     TẢI DANH SÁCH
     ===================================================== */

  async function loadRequests(forceRender = false) {

    try {

      const { data, error } =
        await supabaseClient
          .from("requests")
          .select(`
            id,
            customer_name,
            song_request,
            send_to,
            message,
            youtube_link,
            priority,
            status,
            created_at
          `)
          .or(
            currentTab === "pending"
              ? "status.eq.pending,status.eq.performing"
              : "status.eq.completed"
          )
          .order("created_at", {
            ascending: true
          });


      if (error) {
        throw error;
      }


      /* =================================================
         SẮP XẾP ƯU TIÊN
         ================================================= */

      const orderedData =
        (data || [])
          .slice()
          .sort((a, b) => {

            if (
              a.priority &&
              !b.priority
            ) {
              return -1;
            }

            if (
              !a.priority &&
              b.priority
            ) {
              return 1;
            }

            return (
              new Date(a.created_at) -
              new Date(b.created_at)
            );

          });


      /* =================================================
         ĐẾM SỐ BÀI ĐANG CHỜ
         ================================================= */

      const {
        count: pendingCount,
        error: pendingError
      } =
        await supabaseClient
          .from("requests")
          .select("*", {
            count: "exact",
            head: true
          })
          .eq(
            "status",
            "pending"
          );


      if (!pendingError) {

        document
          .getElementById(
            "pendingCount"
          )
          .textContent =
            pendingCount || 0;

      }


      /* =================================================
         ĐẾM SỐ BÀI ĐÃ HOÀN THÀNH
         ================================================= */

      const {
        count: completedCount,
        error: completedError
      } =
        await supabaseClient
          .from("requests")
          .select("*", {
            count: "exact",
            head: true
          })
          .eq(
            "status",
            "completed"
          );


      if (!completedError) {

        document
          .getElementById(
            "completedCount"
          )
          .textContent =
            completedCount || 0;

      }


      /*
        Tạo chuỗi kiểm tra.

        Nếu dữ liệu không thay đổi
        thì không render lại
        => tránh màn hình nhấp nháy mỗi 2 giây.
      */

      const signature =
        JSON.stringify(
          data || []
        );


      if (
        signature ===
          lastDataSignature &&
        !forceRender
      ) {
        return;
      }


      lastDataSignature =
        signature;


      renderRequests(
        orderedData
      );

    }

    catch (error) {

      console.error(error);

      document
        .getElementById(
          "errorBox"
        )
        .innerHTML = `
          <div class="error">
            ❌ Không thể tải dữ liệu.<br>
            <small>
              ${escapeHtml(
                error.message ||
                "Lỗi kết nối Supabase"
              )}
            </small>
          </div>
        `;

    }

  }


  /* =====================================================
     HIỂN THỊ REQUEST
     ===================================================== */

  function renderRequests(data) {

    const box =
      document.getElementById(
        "requests"
      );


    if (!data.length) {

      box.innerHTML = `
        <div class="empty">

          ${
            currentTab === "pending"
              ? "🎵 Chưa có bài hát nào đang chờ."
              : "✅ Chưa có bài hát nào hoàn thành."
          }

        </div>
      `;

      return;
    }


    box.innerHTML =
      data
        .map(request => {

          const time =
            formatDate(
              request.created_at
            );


          /* =============================================
             YOUTUBE BUTTON
             ============================================= */

          const youtubeButton =
            request.youtube_link
              ? `
                <button
                  class="youtube-btn has-youtube"
                  onclick="openYoutube('${escapeJs(request.youtube_link)}')">
                  🎬 YouTube
                </button>
              `
              : `
                <button
                  class="youtube-btn"
                  onclick="doNothing()">
                  🎬 YouTube
                </button>
              `;


          return `

            <div class="request">

              <div class="request-title">
                🎵
                ${escapeHtml(
                  request.song_request || ""
                )}
              </div>


              <div class="info">
                <span class="label">
                  👤 Tên khách:
                </span>

                ${escapeHtml(
                  request.customer_name || ""
                )}
              </div>


              <div class="info">
                <span class="label">
                  🎤 Muốn gửi cho:
                </span>

                ${escapeHtml(
                  request.send_to || ""
                )}
              </div>


              ${
                request.message
                  ? `
                    <div class="message">

                      <span class="label">
                        💬 Lời nhắn:
                      </span>

                      <br>

                      ${escapeHtml(
                        request.message
                      )}

                    </div>
                  `
                  : ""
              }


              <div class="time-status">

                <div class="time">
                  🕐 ${time}
                </div>


                ${
                  request.priority
                    ? `
                      <div class="priority-icon">
                        🚀
                      </div>
                    `
                    : ""
                }


                <div class="status">

                  ${
                    request.status ===
                    "performing"

                      ? "🔵 Đang giao lưu"

                      : request.status ===
                        "completed"

                        ? "🟢 Hoàn thành"

                        : "🟡 Đang chờ"
                  }

                </div>

              </div>


              <div class="buttons">


                ${
                  currentTab === "pending"

                    ? request.status ===
                      "performing"

                      ? `
                        <button
  class="complete-btn"
  onclick="completeRequest('${request.id}')">
  ✅ Kết thúc
</button>
                      `

                      : `
                        <button
                          class="complete-btn"
                          onclick="
                            startPerformance(
                              '${request.id}'
                            )
                          ">
                          🎤 Giao lưu
                        </button>
                      `

                    : ""
                }


                <!-- ===== YOUTUBE ===== -->

                ${youtubeButton}


                <!-- ===== XÓA ===== -->

                <button
                  class="delete-btn"
                  onclick="
                    deleteRequest(
                      '${request.id}'
                    )
                  ">
                  🗑 Xóa
                </button>


              </div>

            </div>

          `;

        })
        .join("");

  }


  /* =====================================================
     YOUTUBE
     ===================================================== */

  function openYoutube(url) {

    if (!url) {
      return;
    }

    const videoId =
      getYoutubeVideoId(url);

    if (!videoId) {

      alert(
        "Link YouTube không hợp lệ."
      );

      return;
    }


    const frame =
      document.getElementById(
        "youtubeFrame"
      );


    frame.src =
      "https://www.youtube.com/embed/" +
      videoId +
      "?autoplay=1&rel=0";


    document
      .getElementById(
        "youtubeModal"
      )
      .style.display =
        "flex";

  }


  /* =====================================================
     ĐÓNG POPUP YOUTUBE
     ===================================================== */

  function closeYoutube() {

    const frame =
      document.getElementById(
        "youtubeFrame"
      );


    /*
      Xóa src để video dừng hẳn
      khi đóng popup.
    */

    frame.src = "";


    document
      .getElementById(
        "youtubeModal"
      )
      .style.display =
        "none";

  }


  /* =====================================================
     LẤY ID VIDEO YOUTUBE
     ===================================================== */

  function getYoutubeVideoId(url) {

    try {

      const parsed =
        new URL(url);


      /* youtube.com/watch?v=XXXX */

      if (
        parsed.hostname
          .includes("youtube.com") &&
        parsed.searchParams.get("v")
      ) {

        return parsed
          .searchParams
          .get("v");

      }


      /* youtu.be/XXXX */

      if (
        parsed.hostname
          .includes("youtu.be")
      ) {

        return parsed
          .pathname
          .split("/")
          .filter(Boolean)[0];

      }


      /* youtube.com/shorts/XXXX */

      if (
        parsed.hostname
          .includes("youtube.com") &&
        parsed.pathname
          .startsWith("/shorts/")
      ) {

        return parsed
          .pathname
          .split("/")
          .filter(Boolean)[1];

      }


      return null;

    }

    catch (error) {

      return null;

    }

  }


  /* =====================================================
     NÚT YOUTUBE KHÔNG CÓ LINK
     ===================================================== */

  function doNothing() {

    // Không làm gì nếu khách không gửi link YouTube

  }


  /* =====================================================
     ĐÁNH DẤU ĐÃ GIAO LƯU
     ===================================================== */

  async function startPerformance(id) {

    const { error } =
      await supabaseClient
        .from("requests")
        .update({
          status: "performing"
        })
        .eq("id", id);


    if (error) {

      alert(
        "Không thể bắt đầu giao lưu: " +
        error.message
      );

      return;
    }


    lastDataSignature = "";


    await loadRequests(true);

  }


  async function completeRequest(id) {

    try {

      const { error } =
        await supabaseClient
          .from("requests")
          .update({
            status: "completed"
          })
          .eq("id", id);


      if (error) {
        throw error;
      }


      lastDataSignature = "";


      await loadRequests(true);

    }

    catch (error) {

      alert(
        "Không thể cập nhật: " +
        error.message
      );

    }

  }


  /* =====================================================
     XÓA MỘT BÀI
     ===================================================== */

  async function deleteRequest(id) {

    const ok =
      confirm(
        "Anh có chắc muốn xóa bài hát này không?"
      );


    if (!ok) {
      return;
    }


    try {

      const { error } =
        await supabaseClient
          .from("requests")
          .delete()
          .eq("id", id);


      if (error) {
        throw error;
      }


      lastDataSignature = "";


      await loadRequests(true);

    }

    catch (error) {

      alert(
        "Không thể xóa: " +
        error.message
      );

    }

  }


  /* =====================================================
     XÓA TẤT CẢ BÀI ĐÃ HOÀN THÀNH
     ===================================================== */

  async function deleteAllCompleted() {

    const ok =
      confirm(
        "⚠️ Anh có chắc muốn xóa TẤT CẢ bài đã hoàn thành không?"
      );


    if (!ok) {
      return;
    }


    try {

      const { error } =
        await supabaseClient
          .from("requests")
          .delete()
          .eq(
            "status",
            "completed"
          );


      if (error) {
        throw error;
      }


      lastDataSignature = "";


      await loadRequests(true);

    }

    catch (error) {

      alert(
        "Không thể xóa: " +
        error.message
      );

    }

  }


  /* =====================================================
     ĐỊNH DẠNG THỜI GIAN
     ===================================================== */

  function formatDate(dateString) {

    if (!dateString) {
      return "";
    }


    const date =
      new Date(
        dateString
      );


    return date.toLocaleString(
      "vi-VN",
      {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      }
    );

  }


  /* =====================================================
     CHỐNG HTML
     ===================================================== */

  function escapeHtml(value) {

    return String(value)
      .replace(
        /&/g,
        "&amp;"
      )
      .replace(
        /</g,
        "&lt;"
      )
      .replace(
        />/g,
        "&gt;"
      )
      .replace(
        /"/g,
        "&quot;"
      )
      .replace(
        /'/g,
        "&#039;"
      );

  }


  /* =====================================================
     CHỐNG LỖI KHI ĐƯA LINK VÀO ONCLICK
     ===================================================== */

  function escapeJs(value) {

    return String(value)
      .replace(
        /\\/g,
        "\\\\"
      )
      .replace(
        /'/g,
        "\\'"
      )
      .replace(
        /"/g,
        '\\"'
      )
      .replace(
        /\r?\n/g,
        "\\n"
      );

  }


  /* =====================================================
     TỰ ĐỘNG KIỂM TRA DỮ LIỆU
     ===================================================== */

  setInterval(
    () => {

      loadRequests(false);

    },
    2000
  );


  /* =====================================================
     KHỞI ĐỘNG
     ===================================================== */

  updateClearCompletedButton();

  loadRequests(true);

</script>

</body>
</html>

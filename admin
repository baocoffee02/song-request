<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Quản lý yêu cầu bài hát</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #f5f5f5;
    color: #222;
}

header {
    background: #111;
    color: white;
    padding: 20px;
    text-align: center;
}

header h1 {
    margin: 0;
    font-size: 24px;
}

.tabs {
    display: flex;
    background: white;
    border-bottom: 1px solid #ddd;
    position: sticky;
    top: 0;
    z-index: 10;
}

.tab {
    flex: 1;
    padding: 15px;
    border: none;
    background: white;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
}

.tab.active {
    color: #007aff;
    border-bottom: 3px solid #007aff;
}

#requests {
    padding: 15px;
    max-width: 700px;
    margin: auto;
}

.card {
    background: white;
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.song {
    font-size: 21px;
    font-weight: 700;
    margin-bottom: 12px;
}

.info {
    margin: 7px 0;
    font-size: 15px;
}

.label {
    font-weight: 600;
}

.message {
    background: #f5f5f5;
    padding: 10px;
    border-radius: 8px;
    margin-top: 10px;
}

.time {
    color: #888;
    font-size: 13px;
    margin-top: 12px;
}

.buttons {
    display: flex;
    gap: 10px;
    margin-top: 16px;
}

button.action {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 9px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
}

.done {
    background: #34c759;
    color: white;
}

.delete {
    background: #ff3b30;
    color: white;
}

.empty {
    text-align: center;
    color: #888;
    padding: 50px 20px;
    font-size: 16px;
}
</style>
</head>

<body>

<header>
    <h1>🎵 Yêu cầu bài hát</h1>
</header>

<div class="tabs">
    <button id="waitingTab" class="tab active">
        Đang chờ
    </button>

    <button id="completedTab" class="tab">
        Đã hoàn thành
    </button>
</div>

<div id="requests"></div>

<script>

const SUPABASE_URL = "https://ehvaahtsqxoscusanksj.supabase.co";
const SUPABASE_ANON_KEY = "sb_publishable_WmtNVF8-FRnB60urP86nBA_O7qnbKyt";

const supabaseClient = supabase.createClient(
    SUPABASE_URL,
    SUPABASE_ANON_KEY
);

let currentTab = "pending";


// ==========================
// LẤY DANH SÁCH YÊU CẦU
// ==========================

async function loadRequests() {

    let query = supabaseClient
        .from("requests")
        .select("*")
        .order("created_at", {
            ascending: false
        });

    if (currentTab === "pending") {
        query = query.eq("status", "pending");
    } else {
        query = query.eq("status", "completed");
    }

    const { data, error } = await query;

    if (error) {
        console.error(error);
        document.getElementById("requests").innerHTML =
            `<div class="empty">Không thể tải dữ liệu.</div>`;
        return;
    }

    renderRequests(data);
}


// ==========================
// HIỂN THỊ
// ==========================

function renderRequests(data) {

    const container = document.getElementById("requests");

    if (!data || data.length === 0) {

        container.innerHTML = `
            <div class="empty">
                ${currentTab === "waiting"
                    ? "Không có yêu cầu đang chờ."
                    : "Chưa có bài nào hoàn thành."}
            </div>
        `;

        return;
    }

    container.innerHTML = "";

    data.forEach(request => {

        const card = document.createElement("div");
        card.className = "card";

        const date = new Date(request.created_at);

        const time = date.toLocaleString("vi-VN", {
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit"
        });

        card.innerHTML = `

            <div class="song">
                🎵 ${escapeHTML(request.song_request || "")}
            </div>

            <div class="info">
                <span class="label">Tên khách:</span>
                ${escapeHTML(request.customer_name || "")}
            </div>

            <div class="info">
                <span class="label">Muốn gửi cho:</span>
                ${escapeHTML(request.send_to || "")}
            </div>

            ${
                request.message
                ? `
                <div class="message">
                    💬 ${escapeHTML(request.message)}
                </div>
                `
                : ""
            }

            <div class="time">
                🕐 ${time}
            </div>

            <div class="buttons">

                ${
                    currentTab === "waiting"
                    ? `
                    <button
                        class="action done"
                        onclick="markCompleted('${request.id}')">
                        ✓ Đang chờ
                    </button>
                    `
                    : ""
                }

                <button
                    class="action delete"
                    onclick="deleteRequest('${request.id}')">
                    🗑 Xóa yêu cầu
                </button>

            </div>
        `;

        container.appendChild(card);
    });
}


// ==========================
// ĐÁNH DẤU ĐÃ HÁT
// ==========================

async function markCompleted(id) {

    const { error } = await supabaseClient
        .from("requests")
        .update({
            status: "completed"
        })
        .eq("id", id);

    if (error) {

        alert("Không thể cập nhật yêu cầu.");

        console.error(error);

        return;
    }

    loadRequests();
}


// ==========================
// XÓA
// ==========================

async function deleteRequest(id) {

    const ok = confirm(
        "Bạn có chắc muốn xóa yêu cầu này không?"
    );

    if (!ok) return;

    const { error } = await supabaseClient
        .from("requests")
        .delete()
        .eq("id", id);

    if (error) {

        alert("Không thể xóa yêu cầu.");

        console.error(error);

        return;
    }

    loadRequests();
}


// ==========================
// CHUYỂN TAB
// ==========================

document.getElementById("waitingTab").onclick = function() {

    currentTab = "waiting";

    this.classList.add("active");

    document
        .getElementById("completedTab")
        .classList.remove("active");

    loadRequests();
};


document.getElementById("completedTab").onclick = function() {

    currentTab = "completed";

    this.classList.add("active");

    document
        .getElementById("waitingTab")
        .classList.remove("active");

    loadRequests();
};


// ==========================
// TỰ ĐỘNG CẬP NHẬT
// ==========================

supabaseClient
    .channel("requests-realtime")
    .on(
        "postgres_changes",
        {
            event: "*",
            schema: "public",
            table: "requests"
        },
        payload => {

            console.log("Có thay đổi:", payload);

            loadRequests();
        }
    )
    .subscribe();


// ==========================
// CHỐNG HTML INJECTION
// ==========================

function escapeHTML(text) {

    return String(text)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


// ==========================
// CHẠY LẦN ĐẦU
// ==========================

loadRequests();

</script>

</body>
</html>

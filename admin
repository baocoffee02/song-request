     ===================================================== */

  async function completeRequest(id) {

    try {

      const { error } =
        await supabaseClient
          .from("requests")
          .update({

            status:
              "completed",

            completed_at:
              new Date().toISOString()

          })
          .eq(
            "id",
            id
          );


      if (error) {

        throw error;

      }


      lastDataSignature = "";


      await loadRequests(true);

    }

    catch (error) {

      alert(
        "Không thể cập nhật: " +
        error.message
      );

    }

  }



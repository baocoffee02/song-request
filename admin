<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>QUẢN LÝ YÊU CẦU</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;

      /* ===== HÌNH NỀN ===== */
      background-image:
        linear-gradient(rgba(0,0,0,0.35), rgba(0,0,0,0.35)),
        url("./80E39ED9-E68A-40A0-802C-840E92BDC4B1.jpeg");

      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      min-height: 100vh;
    }

    .container {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      padding: 20px;
    }

    h1 {
      text-align: center;
      color: white;
      margin: 10px 0 20px;
      text-shadow: 0 2px 5px rgba(0,0,0,0.5);
    }

    .tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 15px;
    }

    .tab {
      flex: 1;
      padding: 13px;
      border: none;
      border-radius: 10px;
      background: rgba(255,255,255,0.85);
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .tab.active {
      background: #222;
      color: white;
    }

    .clear-completed {
      width: 100%;
      padding: 12px;
      margin-bottom: 15px;
      border: none;
      border-radius: 10px;
      background: #d63031;
      color: white;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }

    .request {
      background: rgba(255,255,255,0.95);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 14px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.18);
    }

    .request-title {
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .info {
      margin: 6px 0;
      line-height: 1.4;
    }

    .label {
      font-weight: bold;
    }

    .message {
      margin-top: 10px;
      padding: 10px;
      background: #f2f2f2;
      border-radius: 8px;
    }

    .time {
      color: #666;
      font-size: 13px;
      margin-top: 10px;
    }

    .buttons {
      display: flex;
      gap: 8px;
      margin-top: 14px;
    }

    .buttons button {
      flex: 1;
      border: none;
      border-radius: 9px;
      padding: 11px 8px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
    }

    .complete-btn {
      background: #27ae60;
      color: white;
    }

    .delete-btn {
      background: #e74c3c;
      color: white;
    }

    .empty {
      background: rgba(255,255,255,0.9);
      padding: 30px;
      border-radius: 14px;
      text-align: center;
      color: #555;
    }

    .error {
      background: #ffe5e5;
      color: #c0392b;
      padding: 15px;
      border-radius: 10px;
      margin-bottom: 15px;
      font-weight: bold;
    }

    .loading {
      background: rgba(255,255,255,0.9);
      padding: 20px;
      border-radius: 12px;
      text-align: center;
    }
.tab span {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 24px;
  height: 24px;

  margin-left: 5px;
  padding: 0 6px;

  border-radius: 50px;

  background: #e74c3c;
  color: white;

  font-size: 13px;
  font-weight: bold;
}
  </style>
</head>

<body>

<div class="container">

  <h1>QUẢN LÝ YÊU CẦU</h1>

  <div class="tabs">
  <button
    id="pendingTab"
    class="tab active"
    onclick="showTab('pending')">
    Đang chờ <span id="pendingCount">0</span>
  </button>
  <button
    id="completedTab"
    class="tab"
    onclick="showTab('completed')">
    Đã hoàn thành <span id="completedCount">0</span>
  </button>
</div>

  <button
    id="clearCompletedButton"
    class="clear-completed"
    onclick="deleteAllCompleted()"
    style="display:none;">
    🗑 Xóa tất cả bài đã hoàn thành
  </button>

  <div id="errorBox"></div>

  <div id="requests">
    <div class="loading">
      Đang tải dữ liệu...
    </div>
  </div>

</div>


<script>

  /* =====================================================
     SUPABASE
     ===================================================== */

  // ⚠️ DÁN LẠI 2 THÔNG TIN CŨ CỦA ANH VÀO ĐÂY

  const SUPABASE_URL = "https://ehvaahtsqxoscusanksj.supabase.co";

  const SUPABASE_ANON_KEY = "sb_publishable_WmtNVF8-FRnB60urP86nBA_O7qnbKyt";


  const supabaseClient = supabase.createClient(
    SUPABASE_URL,
    SUPABASE_ANON_KEY
  );


  /* =====================================================
     BIẾN
     ===================================================== */

  let currentTab = "pending";

  let lastDataSignature = "";


  /* =====================================================
     HIỂN THỊ TAB
     ===================================================== */

  function showTab(tab) {

    currentTab = tab;

    document
      .getElementById("pendingTab")
      .classList.toggle("active", tab === "pending");

    document
      .getElementById("completedTab")
      .classList.toggle("active", tab === "completed");

    updateClearCompletedButton();

    loadRequests(true);
  }


  /* =====================================================
     NÚT XÓA TẤT CẢ BÀI ĐÃ HOÀN THÀNH
     ===================================================== */

  function updateClearCompletedButton() {

    const button =
      document.getElementById("clearCompletedButton");

    if (currentTab === "completed") {
      button.style.display = "block";
    } else {
      button.style.display = "none";
    }
  }


  /* =====================================================
     TẢI DANH SÁCH
     ===================================================== */

  async function loadRequests(forceRender = false) {

    try {

      const { data, error } = await supabaseClient
        .from("requests")

        .select(`
          id,
          customer_name,
          song_request,
          send_to,
          message,
          status,
          created_at
        `)

        .eq("status", currentTab)

        // CŨ NHẤT Ở TRÊN
        .order("created_at", {
          ascending: true
        });


      if (error) {
        throw error;
      }
// Đếm số bài đang chờ
const { count: pendingCount, error: pendingError } =
  await supabaseClient
    .from("requests")
    .select("*", {
      count: "exact",
      head: true
    })
    .eq("status", "pending");
if (!pendingError) {
  document.getElementById("pendingCount").textContent =
    pendingCount || 0;
}
// Đếm số bài đã hoàn thành
const { count: completedCount, error: completedError } =
  await supabaseClient
    .from("requests")
    .select("*", {
      count: "exact",
      head: true
    })
    .eq("status", "completed");
if (!completedError) {
  document.getElementById("completedCount").textContent =
    completedCount || 0;
}


      /*
        Tạo chuỗi kiểm tra.

        Nếu dữ liệu không thay đổi thì không render lại
        => tránh màn hình nhấp nháy mỗi 2 giây.
      */

      const signature = JSON.stringify(
        data || []
      );


      if (
        signature === lastDataSignature &&
        !forceRender
      ) {
        return;
      }


      lastDataSignature = signature;

      renderRequests(data || []);

    }

    catch (error) {

      console.error(error);

      document.getElementById("errorBox").innerHTML = `
        <div class="error">
          ❌ Không thể tải dữ liệu.<br>
          <small>${escapeHtml(error.message || "Lỗi kết nối Supabase")}</small>
        </div>
      `;

    }

  }


  /* =====================================================
     HIỂN THỊ REQUEST
     ===================================================== */

  function renderRequests(data) {

    const box =
      document.getElementById("requests");


    if (!data.length) {

      box.innerHTML = `
        <div class="empty">
          ${
            currentTab === "pending"
              ? "🎵 Chưa có bài hát nào đang chờ."
              : "✅ Chưa có bài hát nào hoàn thành."
          }
        </div>
      `;

      return;
    }


    box.innerHTML = data
      .map(request => {

        const time =
          formatDate(request.created_at);


        return `
          <div class="request">

            <div class="request-title">
              🎵 ${escapeHtml(request.song_request || "")}
            </div>

            <div class="info">
              <span class="label">👤 Tên khách:</span>
              ${escapeHtml(request.customer_name || "")}
            </div>

            <div class="info">
              <span class="label">🎤 Muốn gửi cho:</span>
              ${escapeHtml(request.send_to || "")}
            </div>

            ${
              request.message
                ? `
                  <div class="message">
                    <span class="label">💬 Lời nhắn:</span><br>
                    ${escapeHtml(request.message)}
                  </div>
                `
                : ""
            }

            <div class="time">
              🕐 ${time}
            </div>


            <div class="buttons">

              ${
                currentTab === "pending"

                  ? `
                    <button
                      class="complete-btn"
                      onclick="completeRequest('${request.id}')">
                      ✅ Đã hoàn thành
                    </button>
<button
class="complete-btn"
onclick="deferRequest('${request.id}')">
⏭️ Để sau
</button>
                  `

                  : ""
              }


              <button
                class="delete-btn"
                onclick="deleteRequest('${request.id}')">
                🗑 Xóa
              </button>

            </div>

          </div>
        `;

      })
      .join("");

  }


  /* =====================================================
     ĐÁNH DẤU ĐÃ HOÀN THÀNH
     ===================================================== */

 function deferRequest(id) {
function renderRequests(data) {
  const deferred = JSON.parse(
    localStorage.getItem("deferredRequests") || "[]"
  );

  data.sort((a, b) => {
    const aDeferred = deferred.includes(a.id);
    const bDeferred = deferred.includes(b.id);

    if (aDeferred && !bDeferred) return 1;
    if (!aDeferred && bDeferred) return -1;

    return new Date(a.created_at) - new Date(b.created_at);
  });

  // phần code cũ của anh tiếp tục ở đây...
  const deferred = JSON.parse(
    localStorage.getItem("deferredRequests") || "[]"
  );

  if (!deferred.includes(id)) {
    deferred.push(id);
    localStorage.setItem(
      "deferredRequests",
      JSON.stringify(deferred)
    );
  }

  lastDataSignature = "";
  loadRequests(true);
}

async function completeRequest(id) {
async function completeRequest(id) {

    try {

      const { error } =
        await supabaseClient
          .from("requests")
          .update({
            status: "completed"
          })
          .eq("id", id);


      if (error) {
        throw error;
      }


      // Reset để chắc chắn danh sách được cập nhật
      lastDataSignature = "";

      await loadRequests(true);

    }

    catch (error) {

      alert(
        "Không thể cập nhật: " +
        error.message
      );

    }

  }


  /* =====================================================
     XÓA MỘT BÀI
     ===================================================== */

  async function deleteRequest(id) {

    const ok =
      confirm(
        "Anh có chắc muốn xóa bài hát này không?"
      );


    if (!ok) {
      return;
    }


    try {

      const { error } =
        await supabaseClient
          .from("requests")
          .delete()
          .eq("id", id);


      if (error) {
        throw error;
      }


      lastDataSignature = "";

      await loadRequests(true);

    }

    catch (error) {

      alert(
        "Không thể xóa: " +
        error.message
      );

    }

  }


  /* =====================================================
     XÓA TẤT CẢ BÀI ĐÃ HOÀN THÀNH
     ===================================================== */

  async function deleteAllCompleted() {

    const ok =
      confirm(
        "⚠️ Anh có chắc muốn xóa TẤT CẢ bài đã hoàn thành không?"
      );


    if (!ok) {
      return;
    }


    try {

      const { error } =
        await supabaseClient
          .from("requests")
          .delete()
          .eq("status", "completed");


      if (error) {
        throw error;
      }


      lastDataSignature = "";

      await loadRequests(true);

    }

    catch (error) {

      alert(
        "Không thể xóa: " +
        error.message
      );

    }

  }


  /* =====================================================
     ĐỊNH DẠNG THỜI GIAN
     ===================================================== */

  function formatDate(dateString) {

    if (!dateString) {
      return "";
    }


    const date =
      new Date(dateString);


    return date.toLocaleString(
      "vi-VN",
      {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      }
    );

  }


  /* =====================================================
     CHỐNG HTML
     ===================================================== */

  function escapeHtml(value) {

    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  }


  /* =====================================================
     TỰ ĐỘNG KIỂM TRA DỮ LIỆU
     ===================================================== */

  /*
     Không cần Supabase Realtime.

     Cứ 2 giây kiểm tra một lần.
     Nếu có khách gửi bài mới:
       => admin tự hiện bài mới.

     Nếu có bài được hoàn thành/xóa:
       => danh sách cũng tự cập nhật.
  */

  setInterval(
    () => {
      loadRequests(false);
    },
    2000
  );


  /* =====================================================
     KHỞI ĐỘNG
     ===================================================== */

  updateClearCompletedButton();

  loadRequests(true);

</script>

</body>
</html>

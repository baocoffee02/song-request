<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản lý yêu cầu bài hát</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 20px;
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
    }

    h1 {
      text-align: center;
      margin-bottom: 20px;
    }

    .tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }

    .tab {
      flex: 1;
      padding: 14px;
      border: none;
      border-radius: 10px;
      background: #ddd;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .tab.active {
      background: #222;
      color: white;
    }

    #requests {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .request {
      background: white;
      border-radius: 12px;
      padding: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .row {
      margin-bottom: 8px;
      line-height: 1.5;
    }

    .label {
      font-weight: bold;
    }

    .time {
      color: #777;
      font-size: 13px;
    }

    .actions {
      display: flex;
      gap: 10px;
      margin-top: 14px;
    }

    button.action {
      border: none;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
    }

    .complete {
      background: #22c55e;
      color: white;
      flex: 1;
    }

    .delete {
      background: #ef4444;
      color: white;
    }

    .empty {
      text-align: center;
      color: #888;
      padding: 30px 10px;
    }
  </style>
</head>

<body>

  <h1>🎵 Yêu cầu bài hát</h1>

  <div class="tabs">
    <button id="pendingTab" class="tab active" onclick="showTab('pending')">
      Đang chờ
    </button>

    <button id="completedTab" class="tab" onclick="showTab('completed')">
      Đã hoàn thành
    </button>
  </div>

  <div id="requests">
    <div class="empty">Đang tải...</div>
  </div>

  <script>
    const SUPABASE_URL = "https://ehvaahtsqxoscusanksj.supabase.co";
    const SUPABASE_ANON_KEY = "https://ehvaahtsqxoscusanksj.supabase.co";

    const supabaseClient = window.supabase.createClient(
      SUPABASE_URL,
      SUPABASE_ANON_KEY
    );

    let currentTab = "pending";

    // =========================
    // HIỂN THỊ TAB
    // =========================
    function showTab(tab) {
      currentTab = tab;

      document.getElementById("pendingTab").classList.remove("active");
      document.getElementById("completedTab").classList.remove("active");

      if (tab === "pending") {
        document.getElementById("pendingTab").classList.add("active");
      } else {
        document.getElementById("completedTab").classList.add("active");
      }

      loadRequests();
    }


    // =========================
    // TẢI DANH SÁCH
    // =========================
    async function loadRequests() {

      const container = document.getElementById("requests");

      const { data, error } = await supabaseClient
        .from("requests")
        .select("*")
        .eq("status", currentTab)
        .order("created_at", {
          ascending: true
        });

      if (error) {
        console.error(error);

        container.innerHTML = `
          <div class="empty">
            Không thể tải dữ liệu
          </div>
        `;

        return;
      }

      if (!data || data.length === 0) {
        container.innerHTML = `
          <div class="empty">
            Chưa có yêu cầu bài hát
          </div>
        `;

        return;
      }

      container.innerHTML = "";

      data.forEach(request => {

        const card = document.createElement("div");
        card.className = "request";

        const createdTime = request.created_at
          ? new Date(request.created_at).toLocaleString("vi-VN")
          : "";

        let actionHTML = "";

        if (currentTab === "pending") {
          actionHTML = `
            <button
              class="action complete"
              onclick="markCompleted('${request.id}')">
              ✓ Đang chờ
            </button>
          `;
        }

        card.innerHTML = `
          <div class="row">
            <span class="label">Tên khách:</span>
            ${escapeHTML(request.customer_name || "")}
          </div>

          <div class="row">
            <span class="label">Bài hát:</span>
            ${escapeHTML(request.song_request || "")}
          </div>

          <div class="row">
            <span class="label">Muốn gửi cho:</span>
            ${escapeHTML(request.send_to || "")}
          </div>

          <div class="row">
            <span class="label">Lời nhắn:</span>
            ${escapeHTML(request.message || "")}
          </div>

          <div class="row time">
            Thời gian gửi: ${createdTime}
          </div>

          <div class="actions">

            ${actionHTML}

            <button
              class="action delete"
              onclick="deleteRequest('${request.id}')">
              🗑 Xóa
            </button>

          </div>
        `;

        container.appendChild(card);
      });
    }


    // =========================
    // CHUYỂN SANG ĐÃ HOÀN THÀNH
    // =========================
    async function markCompleted(id) {

      const { error } = await supabaseClient
        .from("requests")
        .update({
          status: "completed"
        })
        .eq("id", id);

      if (error) {
        console.error(error);
        alert("Không thể cập nhật trạng thái");
        return;
      }

      // Cập nhật ngay lập tức
      await loadRequests();
    }


    // =========================
    // XÓA
    // =========================
    async function deleteRequest(id) {

      if (!confirm("Bạn có chắc muốn xóa yêu cầu này không?")) {
        return;
      }

      const { error } = await supabaseClient
        .from("requests")
        .delete()
        .eq("id", id);

      if (error) {
        console.error(error);
        alert("Không thể xóa yêu cầu");
        return;
      }

      // Cập nhật ngay
      await loadRequests();
    }


    // =========================
    // CHỐNG HTML LỖI / XSS
    // =========================
    function escapeHTML(text) {

      return String(text)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }


    // =========================
    // REALTIME
    // =========================
    supabaseClient
      .channel("requests-realtime")
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "requests"
        },
        payload => {

          console.log("Có thay đổi:", payload);

          // Tự động tải lại danh sách
          // Không cần F5
          loadRequests();
        }
      )
      .subscribe(status => {

        console.log("Realtime:", status);

      });


    // =========================
    // TẢI LẦN ĐẦU
    // =========================
    loadRequests();

  </script>

</body>
</html>

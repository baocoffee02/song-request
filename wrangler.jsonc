{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "song-request",
  "main": "./worker.js",
  "compatibility_date": "2026-09-10",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "exclude": [
      "worker.js",
      "wrangler.jsonc",
      "README.md"
    ]
  }
}
